# Google AI Studio key used for the FREE FALLBACK path only — when a learner has not
# supplied their own key. Free tier, no card required, does not expire.
# https://aistudio.google.com/apikey
#
# This key is shared across every user of the deployment and is metered by Google at
# roughly 1,500 requests/day for the whole project. See src/lib/models.ts.
GOOGLE_GENERATIVE_AI_API_KEY=

# Signs the per-session token that caps how many free-fallback turns one session may
# spend. Any long random string: `openssl rand -base64 32`
SESSION_SECRET=

# Optional overrides. Leave unset to use the defaults in src/lib/models.ts.
# TUTOR_MODEL=gemini-3.1-flash-lite
